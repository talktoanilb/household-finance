# Copy to .env for local overrides. Do not commit .env. Local defaults already match docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/household
DB_USER=household
DB_PASSWORD=household
PORT=8080

# Opt-in AI photo reading (OpenAiReader). Leave unset to keep it off; with no key the
# upload page's "Also read with AI" checkbox stays disabled. Never commit a real key.
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
